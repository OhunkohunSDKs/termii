{
  "name": "@ohunkohun/termii-sdk",
  "version": "1.0.0",
  "description": "A TypeScript SDK for the Termii API",
  "scripts": {
    "dev": "tsx watch examples/server.ts",
    "build": "tsc",
    "types:watch": "npx tsc --noEmit --watch"
  },
  "keywords": ["termii", "sdk", "typescript", "javascript", "node", "nodejs", "node.js"],
  "author": "Ohunkóhun",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
      ".": {
          "types": "./dist/index.d.ts",
          "import": "./dist/index.js"
      }
  },
  "files": ["dist"],
  "dependencies": {
    "axios": "^1.20.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.5.1",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  }
}
